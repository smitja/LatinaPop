# Copia in .env.local e completa. Mai committare .env.local.
# I valori locali si leggono con: pnpm exec supabase status -o env

# --- Sito ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (dalla M1) ---
# Locale: API_URL e PUBLISHABLE_KEY di `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo server: mai con prefisso NEXT_PUBLIC_, mai nel repo.
SUPABASE_SECRET_KEY=

# --- Test sul database (pnpm test:db) ---
# Solo database locali: i test rifiutano host remoti.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Demo (SPEC §11) ---
# Solo nell'ambiente demo, con il suo database. Se l'URL Supabase coincide con
# PRODUCTION_SUPABASE_URL l'app si rifiuta di partire.
DEMO_MODE=false
PRODUCTION_SUPABASE_URL=

# --- Notifiche push (M7) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# --- Playwright nelle sessioni cloud (Chromium preinstallato) ---
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/opt/pw-browsers/chromium
